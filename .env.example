# Web UI / Docker environment. Copy to `.env` (git-ignored); the container reads
# these govc vars directly. Same values as config.env's GOVC_* block.
GOVC_URL=https://esxi-host.example.com/sdk
GOVC_USERNAME=root
GOVC_PASSWORD=change-me
GOVC_INSECURE=1
GOVC_DATASTORE=datastore1
GOVC_NETWORK=VM Network

# Optional: prefill an SSH public key in the deploy form
DEFAULT_SSH_PUBKEY=

# Optional: enable HTTP Basic auth. When VMDEPLOY_PASSWORD is set, the whole UI
# requires login, and the ⚙ Settings dialog can edit the ESXi connection +
# credentials. Leave blank to run open (LAN/trusted only) — then Settings can
# still edit the non-secret placement defaults, but the connection stays locked.
VMDEPLOY_USERNAME=admin
VMDEPLOY_PASSWORD=
