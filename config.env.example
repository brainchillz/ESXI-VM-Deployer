# ESXI-VM-Deployer — Python client configuration.
#
# Either copy this to config.env and fill it in, or (recommended) keep the real
# values in your private inventory repo and point the installer at them:
#   sudo ./client-install.sh --config /path/to/your-infra-repo/esxi/config.env
#
# config.env is git-ignored — it holds credentials.

# ---- govc / ESXi host connection ----------------------------------------------
# NOTE: this deployer targets a STANDALONE ESXi host, not vCenter. The host must
# have a real (eval or paid) license — the free vSphere Hypervisor license makes
# the API read-only and every deploy will fail.
export GOVC_URL="https://esxi-host.example.com/sdk"  # ESXi FQDN or IP
export GOVC_USERNAME="root"
export GOVC_PASSWORD="change-me"
export GOVC_INSECURE="1"                            # 1 = skip TLS verify (self-signed)

# ---- Placement (used when deploying from a template) ---------------------------
# No datacenter / resource pool / VM folder here: a standalone host has one
# synthetic datacenter (ha-datacenter), one implicit pool, and no VM folders.
export GOVC_DATASTORE="datastore1"
export GOVC_NETWORK="VM Network"                    # portgroup the NIC attaches to

# ---- Deploy defaults (overridable by deploy-vm flags) -------------------------
DEFAULT_PROFILE="ubuntu-2604"                       # matched against template annotations
DEFAULT_CIDR="24"                                   # your subnet's prefix length
DEFAULT_DNS="1.1.1.1, 8.8.8.8"
DEFAULT_SSH_KEY="$HOME/.ssh/id_ed25519.pub"         # public key injected into the user
DEFAULT_SSH_PUBKEY=""                               # alt: inline key text (fallback if file absent)

# ── Web UI: accounts and sessions ─────────────────────────────────────
# Authentication is no longer optional. On first run the app creates an
# account from VMDEPLOY_USERNAME / VMDEPLOY_PASSWORD if they are set, and
# otherwise generates one and prints the password to the container log once.
# Accounts live in /data/users.json thereafter; these two are only ever read
# to bootstrap the first one.
# VMDEPLOY_USERNAME=admin
# VMDEPLOY_PASSWORD=

# How long a browser session lasts before signing in again.
# VMDEPLOY_SESSION_HOURS=12

# The session cookie's Secure flag. Defaults to on. Set 0 ONLY when serving
# plain HTTP on localhost for development — behind a TLS terminator the app
# cannot infer TLS from its own listener, so leaving this on is what keeps the
# cookie off the wire.
# VMDEPLOY_COOKIE_SECURE=1

# ── Web UI: single sign-on (optional) ─────────────────────────────────
# Off unless set. With no issuer the app registers no /sso/callback route and
# behaves exactly as it did before. Enrolling from the UI with a one-time code
# writes the same values to /data/sso.json instead; setting them here fixes
# the decision at install time and makes the UI read-only.
#
# An assertion is exchanged for a session at /sso/callback and nowhere else —
# it is never a bearer credential. The subject must ALREADY have a local
# account here: SSO grants access to accounts that exist, it never creates
# them. The local password and HTTP Basic keep working, so an issuer outage
# cannot lock you out of the tool that deploys your VMs.
#
# VMDEPLOY_SSO_ISSUER=https://sso.example.com
# VMDEPLOY_SSO_PUBKEY=
# VMDEPLOY_SSO_KID=
# VMDEPLOY_SSO_AUDIENCE=
